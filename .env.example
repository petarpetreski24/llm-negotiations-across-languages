# Copy to .env and fill in. Never commit .env.
# Hugging Face token: only needed to download gated models (TranslateGemma, CometKiwi).
HF_TOKEN=

# Model servers on the FINKI GPU node (localhost inside the SLURM job, or forwarded through an SSH tunnel).
NEGOTIATOR_BASE_URL=http://localhost:8000/v1
NEGOTIATOR2_BASE_URL=http://localhost:8001/v1
MT2_BASE_URL=http://localhost:8002/v1
NLLB_BASE_URL=http://localhost:8003
BACKTRANSLATE_BASE_URL=http://localhost:8004/v1
